# Copy this file to .env.local and fill in the values there.
# NEVER put real values in this file — it is committed to GitHub.
# Full explanation of every variable: docs/prp/13-apis-env.md

# Public (safe in the browser)
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — server only. Never add NEXT_PUBLIC_ to these.
SUPABASE_SECRET_KEY=

# Email provider for invitation emails (from Step 11, decision D-33)
EMAIL_API_KEY=
EMAIL_FROM=
